# Environment Variables for Noshi Agent Vessel

# Vision Language Model Configuration
VLM_PROVIDER=huggingface
VLM_BASE_URL=http://your_endpoint.aws.endpoints.huggingface.cloud/v1
VLM_API_KEY=hf_your_api_key
VLM_MODEL_NAME=your_model_name

# Telemetry Settings (opt-in, default OFF)
ENABLE_TELEMETRY=false
TELEMETRY_ENDPOINT=

# Development Settings
NODE_ENV=development
DEBUG=false

# API Configuration
API_BASE_URL=
API_KEY=

# Logging
LOG_LEVEL=info

# Security
DISABLE_NODE_INTEGRATION=true

# Apple Code Signing (for macOS builds)
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
KEYCHAIN_PATH=

# Windows Code Signing
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
